# Copy to .env and fill in. .env is git-ignored. Nothing here is required for mock mode.

# --- PayPal ---------------------------------------------------------------
# mock    = run end-to-end against the built-in simulated PayPal API (no account needed)
# sandbox = real PayPal sandbox (https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # default; Leash refuses non-sandbox hosts

# --- App ------------------------------------------------------------------
PORT=3070
# Where PayPal sends the buyer back after approval (must reach this server from your browser)
APP_BASE_URL=http://localhost:3070
CURRENCY=USD
BRAND_NAME=Leash Demo Store

# --- AI (optional) --------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Leave empty to use the built-in rule parser.
# e.g. LLM_BASE_URL=https://api.meta.ai/v1      LLM_MODEL=muse-spark-1.3   (Meta Model API — used in the demo)
#      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000

# --- Catalog (optional) ---------------------------------------------------
# local    = bundled fictional catalog (offline)
# channel3 = live product search via Channel3 (https://trychannel3.com/developers)
CATALOG_SOURCE=local
CHANNEL3_API_KEY=
